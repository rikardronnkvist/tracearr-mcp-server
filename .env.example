# Copy to .env and fill in your values.
TRACEARR_URL=http://192.168.1.50:3000

# Tracearr > Settings > General > API key (format trr_pub_<token>). Needs Tracearr
# 2.0.0 or later, and the key must belong to an owner account (otherwise 403).
TRACEARR_API_KEY=replace-with-your-tracearr-api-key

# Interface/port the MCP server listens on inside the container.
MCP_HOST=0.0.0.0
MCP_PORT=8942

# OAuth login through an OpenID Connect provider (e.g. Authentik). Set all four,
# or none. MCP_PUBLIC_URL is the URL clients reach this server at (no /mcp suffix);
# the provider's redirect URI is MCP_PUBLIC_URL + /oauth/callback.
OIDC_CONFIG_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
MCP_PUBLIC_URL=

# Shared secret accepted as `Authorization: Bearer <token>`. Without OIDC this is
# the only protection: leave both unset and anyone who can reach the port can read
# every user's watch history and email address through this server. With OIDC it
# is optional (for scripts). Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
